{
  "name": "@mittwald/api-models-react",
  "version": "4.493.1",
  "author": "Mittwald CM Service GmbH & Co. KG <opensource@mittwald.de>",
  "type": "module",
  "description": "React bindings for the mittwald API domain models",
  "keywords": [
    "api",
    "client",
    "mittwald",
    "models",
    "react"
  ],
  "homepage": "https://developer.mittwald.de",
  "repository": "github:mittwald/api-client-js",
  "bugs": {
    "url": "https://github.com/mittwald/api-client-js/issues"
  },
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "run build:clean && run tsc",
    "build:clean": "rimraf dist",
    "format": "run prettier --write '**/*.{ts,tsx,yaml,yml,json,md,mdx,js}'",
    "lint": "run eslint .",
    "test": "",
    "test:compile": "run tsc --noEmit",
    "test:unit": "run vitest run"
  },
  "dependencies": {
    "@mittwald/api-models": "workspace:^",
    "@mittwald/react-async-proxy": "^0.0.12",
    "@mittwald/react-ghostmaker": "^1.6.0",
    "@sindresorhus/is": "^8.1.0",
    "minimatch": "^10.2.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@mittwald/api-client": "workspace:^",
    "@mittwald/api-client-commons": "workspace:^",
    "@tanstack/react-query": "^5.102.8",
    "@types/react": "^19.2.17",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-json": "^5.0.0",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "react": "^19.2.7",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.8"
  },
  "peerDependencies": {
    "@mittwald/api-client": "workspace:^",
    "@mittwald/api-client-commons": "workspace:^",
    "@tanstack/react-query": "^5",
    "react": ">=19.2"
  }
}
