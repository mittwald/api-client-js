  "author": "Mittwald CM Service GmbH & Co. KG <opensource@mittwald.de>",
  "type": "module",
  "description": "Collection of domain models for coherent interaction with the API",
  "keywords": [
    "api",
    "client",
    "mittwald",
    "rest",
    "sdk"
